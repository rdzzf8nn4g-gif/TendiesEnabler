<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key> <string>PSGroupCell</string>
            <key>label</key> <string>生效开关</string>
        </dict>
        <dict>
            <key>cell</key> <string>PSSwitchCell</string>
            <key>default</key> <true/>
            <key>defaults</key> <string>com.yourname.tendiesprefs</string>
            <key>key</key> <string>Enabled</string>
            <key>label</key> <string>开启交互壁纸</string>
            <key>PostNotification</key> <string>com.yourname.tendiesprefs/ReloadPrefs</string>
        </dict>
        
        <dict>
            <key>cell</key> <string>PSGroupCell</string>
            <key>label</key> <string>壁纸路径配置</string>
            <key>footerText</key> <string>请填入解压后的 .tendies 绝对路径（建议放于 /var/mobile/Documents/ 内）。支持多层 .ca 动画渲染。</string>
        </dict>
        <dict>
            <key>cell</key> <string>PSEditTextCell</string>
            <key>default</key> <string>/var/mobile/Documents/Mario.tendies</string>
            <key>defaults</key> <string>com.yourname.tendiesprefs</string>
            <key>key</key> <string>TendiesPath</string>
            <key>placeholder</key> <string>输入 .tendies 绝对路径</string>
            <key>PostNotification</key> <string>com.yourname.tendiesprefs/ReloadPrefs</string>
        </dict>

        <dict>
            <key>cell</key> <string>PSGroupCell</string>
        </dict>
        <dict>
            <key>cell</key> <string>PSButtonCell</string>
            <key>label</key> <string>在 Filza 打开路径</string>
            <key>action</key> <string>openFilzaPath:</string>
        </dict>
    </array>
    <key>title</key>
    <string>TendiesEnabler</string>
</dict>
</plist>
