<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key> <string>PSGroupCell</string>
            <key>label</key> <string>生效开关</string>
        </dict>
        <dict>
            <key>cell</key> <string>PSSwitchCell</string>
            <key>default</key> <true/>
            <key>defaults</key> <string>com.yourname.tendiesprefs</string>
            <key>key</key> <string>Enabled</string>
            <key>label</key> <string>开启交互壁纸</string>
            <key>PostNotification</key> <string>com.yourname.tendiesprefs/ReloadPrefs</string>
        </dict>
        
        <dict>
            <key>cell</key> <string>PSGroupCell</string>
            <key>label</key> <string>壁纸导入</string>
            <key>footerText</key> <string>点击按钮直接从“文件”App选择 .tendies 文件，插件会自动拷贝并配置路径。</string>
        </dict>
        <dict>
            <key>cell</key> <string>PSButtonCell</string>
            <key>label</key> <string>📥 导入 .tendies 壁纸</string>
            <key>action</key> <string>importTendies:</string>
        </dict>

        <dict>
            <key>cell</key> <string>PSGroupCell</string>
        </dict>
        <dict>
            <key>cell</key> <string>PSButtonCell</string>
            <key>label</key> <string>📂 在 Filza 查看当前壁纸</string>
            <key>action</key> <string>openFilzaPath:</string>
        </dict>
    </array>
    <key>title</key>
    <string>TendiesEnabler</string>
</dict>
</plist>
